{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jev-etymology-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-27",
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}

